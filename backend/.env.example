# ==============================================================================
# SkinMatch App - Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB: mongodb://127.0.0.1:27017/skinmatch
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/skinmatch
MONGODB_URI=mongodb://127.0.0.1:27017/skinmatch

# Redis Cache (Optional - In-Memory NodeCache fallback will be used if omitted)
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini API Key (Required for AI Skin Analysis & INCI Ingredient Matching)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
